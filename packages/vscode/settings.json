{
	"workbench.colorTheme": "larsmagnus/dev dark",
	"editor.wordWrap": "off",
	// Less chonky scroll bars
	"editor.scrollbar.verticalScrollbarSize": 8,
	"editor.scrollbar.horizontalScrollbarSize": 8,
	"editor.inlineSuggest.enabled": false,
	"editor.renderWhitespace": "none",
	"editor.fontSize": 14,
	// https://monaspace.githubnext.com/
	"editor.fontFamily": "'Monaspace Neon Var', monospace",
	"editor.fontLigatures": "'calt', 'liga', 'ss03', 'ss06', 'ss07', 'ss08', 'ss09'",
	"editor.fontVariations": "'wght' 350, 'wdth' 100",
	"editor.lineHeight": 1.6,
	"editor.lineNumbers": "on",
	"editor.folding": true,
	"editor.minimap.enabled": true,
	"editor.scrollBeyondLastLine": false,
	"editor.guides.indentation": true,
	"editor.formatOnSave": true,
	"editor.defaultFormatter": "oxc.oxc-vscode",
	"terminal.integrated.fontFamily": "'Monaspace Krypton Var', monospace",
	"terminal.integrated.fontSize": 13,
	"terminal.integrated.lineHeight": 1.4,
	"terminal.integrated.letterSpacing": 1,
	// apc extension for advanced ui customisation
	// https://github.com/drcika/apc-extension?tab=readme-ov-file#supported-configuration-options
	"apc.parts.font.family": {
		"sidebar": "'Monaspace Krypton Var', monospace",
		"titlebar": "'Monaspace Argon Var', monospace",
		"tabs": "'Monaspace Argon Var', monospace",
		"activityBar": "'Monaspace Krypton Var', monospace",
		"panel": "'Monaspace Krypton Var', monospace",
		"statusbar": "'Monaspace Krypton Var', monospace",
		"settings-body": "'Monaspace Krypton Var', monospace",
		"extension-editor": "'Monaspace Krypton Var', monospace", // Install the font and restart vscode
		"monaco-menu": "'Monaspace Krypton Var', monospace"
	},
	"apc.electron": {
		"frame": false
	},
	"apc.activityBar": {
		"size": 38
	},
	// Comand Palette / quickInput (cmd+p)
	"apc.listRow": {
		"parts": {
			"quick-input-list": {
				"fontSize": 14,
				"height": 38
			}
		}
	},
	// Set the font of the quickInput
	"apc.stylesheet": {
		// list items
		".quick-input-list.custom-list-row .monaco-list-row": "font-family: 'Monaspace Argon Var', monospace;",
		// list item icon - vertically center
		".quick-input-widget .quick-input-list-entry .codicon[class*=codicon-]": "font-size: 15px; margin-top: 8px",
		// input field
		".quick-input-widget .monaco-inputbox": "font-family: 'Monaspace Argon Var', monospace; padding: 8px; border-radius: 6px; font-size: 14px;"
	},
	"[json]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[shellscript]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[mdx]": {
		"editor.wordWrap": "bounded"
	},
	"zenMode.fullScreen": false,
	"zenMode.centerLayout": false,
	// multiCommand
	"multiCommand.commands": [
		{
			"command": "multiCommand.betterZenMode",
			"sequence": [
				"workbench.action.toggleZenMode",
				"settings.cycle.zenModeExtras"
			]
		}
	],
	// Settings cycle
	"settings.cycle": [
		{
			"id": "zenModeExtras",
			"values": [
				{
					"editor.lineNumbers": "off",
					"editor.guides.indentation": false,
					"editor.minimap.enabled": false,
					"editor.wordWrap": "on",
					"scm.diffDecorations": "none"
				},
				{
					"editor.lineNumbers": "on",
					"editor.guides.indentation": true,
					"editor.minimap.enabled": true,
					"editor.wordWrap": "off",
					"scm.diffDecorations": "all"
				}
			]
		}
	],
	"scm.diffDecorations": "all",
	"svelte.enable-ts-plugin": true,
	"typescript.tsdk": "node_modules/typescript/lib",
	"files.autoSave": "onFocusChange",
	"files.associations": {
		"*.css": "tailwindcss"
	},
	"terminal.external.osxExec": "Ghostty.app",
	// Don't annoy me when deleting or moving things
	"explorer.confirmDelete": false,
	"explorer.confirmDragAndDrop": false,
	// Update imports when moving a file
	"typescript.updateImportsOnFileMove.enabled": "always",
	"javascript.updateImportsOnFileMove.enabled": "always",
	"console-ninja.featureSet": "Community",
	// Turn off sounds
	"editor.accessibilitySupport": "off",
	"accessibility.signals.lineHasError": {
		"sound": "off"
	},
	// commandCenter toggles the search bar + prev/next arrows at the top
	// Can use cmd+p, cmd+shift+p, cmd+z, cmd+shift+z hotkeys
	"window.commandCenter": true,
	"terminal.integrated.env.osx": {
		"CW_NEW_SESSION": "1"
	},
	// The schema is only needed when editing externally
	"$schema": "vscode://schemas/settings/user",
	"typescript.preferences.importModuleSpecifier": "non-relative",
	"javascript.preferences.importModuleSpecifier": "non-relative",
	"workbench.editorAssociations": {
		"*.svg": "default",
		"*.md": "punchdown.markdownEditor"
	},
	"github.copilot.enable": {
		"markdown": true
	},
	"typescript.preferences.preferTypeOnlyAutoImports": true,
	"terminal.integrated.defaultProfile.osx": "zsh",
	"redhat.telemetry.enabled": false,
	"chat.agentsControl.enabled": "hidden",
	"workbench.editor.empty.hint": "hidden",
	"explorer.confirmPasteNative": false,
	"yaml.disableSchemaDetection": [
		"**/docker-compose.yml",
		"**/docker-compose.yaml",
		"**/docker-compose.*.yml",
		"**/docker-compose.*.yaml",
		"**/compose.yml",
		"**/compose.yaml",
		"**/compose.*.yml",
		"**/compose.*.yaml",
		"**/.github/workflows/*.yml",
		"**/.github/workflows/*.yaml",
		"**/.gitea/workflows/*.yml",
		"**/.gitea/workflows/*.yaml",
		"**/.forgejo/workflows/*.yml",
		"**/.forgejo/workflows/*.yaml"
	],
	"editorMarkdownNotes.hideNav": true,
	"files.trimTrailingWhitespace": true,
	"files.insertFinalNewline": true,
	"editorMarkdownNotes.centerContent": true
}
