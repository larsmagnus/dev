# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Claude
.claude/worktrees
# unlike project-level .claude/settings.local.json, Claude Code doesn't
# auto-ignore this at ~/.claude scope - guard it here in case one is ever
# added, since it's the natural place for machine-local secrets
.claude/settings.local.json

#mcp 
.playwright-mcp/

# Development
node_modules
build
dist
out

# local env files
.env
.env*.local

# except .env template files
!.env.template

# testing
coverage

# debug
error.log
access.log
.pnpm-debug.log*

# "bad" file names (mostly for obsidian)
null*

# misc
.DS_Store
*.pem

# Thumbnails
._*

# Files that might appear on external disk
.Spotlight-V100
.Trashes

# Obsidian
**/*obsidian/workspace
**/*obsidian/workspace*.json
**/*obsidian/types.json
**/*obsidian/starred.json
**/*obsidian/quickshare.json

## Don't commit plugin core files
**/*obsidian/plugins/*/main.js
**/*obsidian/plugins/*/styles.css
