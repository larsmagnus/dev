{
	"compilerOptions": {
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "ES2022",
		"lib": ["ES2022"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"types": ["node"],
		"typeRoots": ["../../../../node_modules/@types"]
	},
	"include": [
		"./*.ts",
		"../hooks/ledger.ts",
		"../hooks/parse.ts",
		"../types/index.d.ts"
	]
}
