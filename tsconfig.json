{
	"compilerOptions": {
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "ES2022",
		"lib": ["ES2022"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"types": ["node"]
	},
	"include": [
		".claude/plugins/**/*.mts",
		".claude/plugins/**/*.mjs",
		".claude/agents/**/scripts/**/*.ts"
	]
}
