{
	"name": "larsmagnus-dev",
	"description": "dev setup, config and productivity scripts",
	"version": "0.0.1",
	"author": "Lars Magnus Klavenes <larsmagnus@gmail.com> (https://larsmagnus.co)",
	"funding": "https://larsmagnus.co/donate",
	"license": "MIT",
	"packageManager": "pnpm@9.11.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/larsmagnus/dev.git"
	},
	"bugs": {
		"url": "https://github.com/larsmagnus/dev/issues"
	},
	"homepage": "https://larsmagnus.co",
	"scripts": {
		"lint": "oxlint --fix && oxfmt",
		"lint:check": "oxlint && oxfmt --check",
		"typecheck": "tsc --noEmit",
		"complexity": "fta . --config-path fta.json && fta .claude --config-path fta.json",
		"duplication": "jscpd -c .jscpd.json",
		"duplication:check": "jscpd -c .jscpd.json --reporters console,json --threshold 3",
		"verify": "pnpm lint && pnpm complexity && pnpm duplication && pnpm knip",
		"verify:check": "pnpm lint:check && pnpm complexity && pnpm duplication:check && pnpm knip",
		"knip": "knip",
		"test": "claude plugin test .claude/mods/agent-dock"
	},
	"devDependencies": {
		"@types/node": "26.6.4",
		"knip": "6.41.0",
		"lefthook": "2.2.1",
		"oxfmt": "0.72.0",
		"oxlint": "1.87.0",
		"oxlint-tsgolint": "7.0.2003",
		"typescript": "7.0.2"
	},
	"dependencies": {
		"fta-cli": "3.1.0",
		"jscpd": "5.4.0",
		"zod": "4.6.5"
	},
	"keywords": [
		"setup",
		"config",
		"dev",
		"claude",
		"skills",
		"scripts",
		"shell",
		"productivity",
		"vscode"
	]
}
